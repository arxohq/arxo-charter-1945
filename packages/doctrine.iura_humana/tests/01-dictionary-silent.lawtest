language "law.core" version "0.2";
package doctrine.iura_humana version "0.1.0";
namespace "urn:doctrine:clir:iura-humana";

test "urn:query:iura-humana-silent" {
    given {
        context { decision_time @2026-09-18T12:00:00Z; knowledge_time @2026-09-18T12:00:00Z; legal_time @2026-09-18; timezone "UTC"; }
    }
    evaluate truth(ius_declaratum(entity_ref("urn:casus:homo:1"), entity_ref("urn:casus:actus:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
