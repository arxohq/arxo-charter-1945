language "law.core" version "0.2";
package examples.un.charter.binding_or_not version "0.1.0";
namespace "urn:law:examples:un-charter:binding-or-not";

// UNC-31: the Security Council is exercising its functions on the matter
// (Art. 12, para. 1) and has not requested an Assembly recommendation, so
// the Assembly's Article 10 recommendation power is barred.

case BarredWhileSeized {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const m: un.charter::Matter = entity_ref("urn:law:examples:un-charter:binding-or-not:seized-matter");

    assert "scope": un.charter::matter_within_charter_scope(m) { origin case_input; }
    assert "seized": un.charter::security_council_seized_of_matter(m) { origin case_input; }
}
