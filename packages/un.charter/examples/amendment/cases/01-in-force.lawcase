language "law.core" version "0.2";
package examples.un.charter.amendment version "0.1.0";
namespace "urn:law:examples:un-charter:amendment";

// UNC-25: adoption by two thirds of the members of the Assembly, ratified by
// two thirds of the Members including all five permanent members named by
// Article 23 (letter of Article 108, no reading). World: fifteen Members —
// the five permanent members plus ten fictional Members — so two thirds is
// ten states exactly (10*3 >= 15*2).

case InForce {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const d: un.charter::Decision = entity_ref("urn:law:examples:un-charter:amendment:amendment-vote");
    const china: un.charter::State = entity_ref("urn:un:corpus:clir:charter#RepublicOfChina");
    const france: un.charter::State = entity_ref("urn:un:corpus:clir:charter#FranceState");
    const soviet: un.charter::State = entity_ref("urn:un:corpus:clir:charter#SovietUnion");
    const uk: un.charter::State = entity_ref("urn:un:corpus:clir:charter#UnitedKingdomState");
    const us: un.charter::State = entity_ref("urn:un:corpus:clir:charter#UnitedStatesState");
    const m0: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m0");
    const m1: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m1");
    const m2: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m2");
    const m3: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m3");
    const m4: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m4");
    const m5: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m5");
    const m6: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m6");
    const m7: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m7");
    const m8: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m8");
    const m9: un.charter::State = entity_ref("urn:law:examples:un-charter:amendment:m9");

    assert "vote": un.charter::is_amendment_vote(d) { origin case_input; }

    assert "member-china": un.charter::member_state(china) { origin case_input; }
    assert "member-france": un.charter::member_state(france) { origin case_input; }
    assert "member-soviet": un.charter::member_state(soviet) { origin case_input; }
    assert "member-uk": un.charter::member_state(uk) { origin case_input; }
    assert "member-us": un.charter::member_state(us) { origin case_input; }
    assert "member-m0": un.charter::member_state(m0) { origin case_input; }
    assert "member-m1": un.charter::member_state(m1) { origin case_input; }
    assert "member-m2": un.charter::member_state(m2) { origin case_input; }
    assert "member-m3": un.charter::member_state(m3) { origin case_input; }
    assert "member-m4": un.charter::member_state(m4) { origin case_input; }
    assert "member-m5": un.charter::member_state(m5) { origin case_input; }
    assert "member-m6": un.charter::member_state(m6) { origin case_input; }
    assert "member-m7": un.charter::member_state(m7) { origin case_input; }
    assert "member-m8": un.charter::member_state(m8) { origin case_input; }
    assert "member-m9": un.charter::member_state(m9) { origin case_input; }

    assert "vote-china": un.charter::casts_vote_for(d, china) { origin case_input; }
    assert "vote-france": un.charter::casts_vote_for(d, france) { origin case_input; }
    assert "vote-soviet": un.charter::casts_vote_for(d, soviet) { origin case_input; }
    assert "vote-uk": un.charter::casts_vote_for(d, uk) { origin case_input; }
    assert "vote-us": un.charter::casts_vote_for(d, us) { origin case_input; }
    assert "vote-m0": un.charter::casts_vote_for(d, m0) { origin case_input; }
    assert "vote-m1": un.charter::casts_vote_for(d, m1) { origin case_input; }
    assert "vote-m2": un.charter::casts_vote_for(d, m2) { origin case_input; }
    assert "vote-m3": un.charter::casts_vote_for(d, m3) { origin case_input; }
    assert "vote-m4": un.charter::casts_vote_for(d, m4) { origin case_input; }
    assert "vote-m5": un.charter::casts_vote_for(d, m5) { origin case_input; }
    assert "vote-m6": un.charter::casts_vote_for(d, m6) { origin case_input; }
    assert "vote-m7": un.charter::casts_vote_for(d, m7) { origin case_input; }
    assert "vote-m8": un.charter::casts_vote_for(d, m8) { origin case_input; }
    assert "vote-m9": un.charter::casts_vote_for(d, m9) { origin case_input; }

    assert "ratified-china": un.charter::ratified_by(d, china) { origin case_input; }
    assert "ratified-france": un.charter::ratified_by(d, france) { origin case_input; }
    assert "ratified-soviet": un.charter::ratified_by(d, soviet) { origin case_input; }
    assert "ratified-uk": un.charter::ratified_by(d, uk) { origin case_input; }
    assert "ratified-us": un.charter::ratified_by(d, us) { origin case_input; }
    assert "ratified-m0": un.charter::ratified_by(d, m0) { origin case_input; }
    assert "ratified-m1": un.charter::ratified_by(d, m1) { origin case_input; }
    assert "ratified-m2": un.charter::ratified_by(d, m2) { origin case_input; }
    assert "ratified-m3": un.charter::ratified_by(d, m3) { origin case_input; }
    assert "ratified-m4": un.charter::ratified_by(d, m4) { origin case_input; }
    assert "ratified-m5": un.charter::ratified_by(d, m5) { origin case_input; }
    assert "ratified-m6": un.charter::ratified_by(d, m6) { origin case_input; }
    assert "ratified-m7": un.charter::ratified_by(d, m7) { origin case_input; }
    assert "ratified-m8": un.charter::ratified_by(d, m8) { origin case_input; }
    assert "ratified-m9": un.charter::ratified_by(d, m9) { origin case_input; }
}
