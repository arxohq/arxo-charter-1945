language "law.core" version "0.2";
package examples.un.charter.pacific_settlement version "0.1.0";
namespace "urn:law:examples:un-charter:pacific-settlement";

// UNC-42 / UNC-43: still before the Council, but the dispute also turns out
// to have a legal character. Under article 36(1) the Council recommends
// procedures; under article 36(3) it also recommends referral to the ICJ.
// Article 34's and article 37(2)'s findings remain unsupplied, so those two
// conclusions still sit at REQUIRES_JUDGMENT, unaffected by this article 36
// track (article 36 operates "at any stage", independently).

case LegalDisputeToCourt {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const d: un.charter::Dispute = entity_ref("urn:law:examples:un-charter:pacific-settlement:dispute");
    const state_a: un.charter::State = entity_ref("urn:law:examples:un-charter:pacific-settlement:state-a");
    const state_b: un.charter::State = entity_ref("urn:law:examples:un-charter:pacific-settlement:state-b");

    assert "threshold": un.charter::dispute_likely_to_endanger_peace_and_security(d) { origin case_input; }
    assert "party-a": un.charter::party_to_dispute(d, state_a) { origin case_input; }
    assert "party-b": un.charter::party_to_dispute(d, state_b) { origin case_input; }
    assert "sought-a": un.charter::sought_peaceful_settlement(d, state_a) { origin case_input; }
    assert "sought-b": un.charter::sought_peaceful_settlement(d, state_b) { origin case_input; }
    assert "not-settled": un.charter::dispute_not_settled_by_article_33_means(d) { origin case_input; }
    assert "referred-a": un.charter::dispute_referred_to_security_council(d, state_a) { origin case_input; }
    assert "referred-b": un.charter::dispute_referred_to_security_council(d, state_b) { origin case_input; }
    assert "procedures-recommended": un.charter::security_council_recommends_procedures_for_dispute(d) { origin case_input; }
    assert "legal": un.charter::legal_dispute(d) { origin case_input; }
    assert "icj-recommended": un.charter::security_council_recommends_icj_referral(d) { origin case_input; }
    assert "member-a": un.charter::member_state(state_a) { origin case_input; }
    assert "brought": un.charter::dispute_brought_to_attention(state_a, d) { origin case_input; }
}
