language "law.core" version "0.2";
package examples.un.charter.article_51_silence version "0.1.0";
namespace "urn:law:examples:un-charter:article-51-silence";

// UNC-03: measures taken, not reported — the duty stays ACTIVE.

case UnreportedDuty {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const attacker: un.charter::State = entity_ref("urn:law:examples:un-charter:a51:attacker");
    const victim: un.charter::State = entity_ref("urn:law:examples:un-charter:a51:victim");

    assert "member": un.charter::member_state(attacker) { origin case_input; }
    assert "grave": un.charter::grave_armed_attack(victim, attacker) { origin case_input; }
    assert "taken": un.charter::self_defence_measures_taken(attacker, victim) { origin case_input; }
}
