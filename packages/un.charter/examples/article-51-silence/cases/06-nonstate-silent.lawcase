language "law.core" version "0.2";
package examples.un.charter.article_51_silence version "0.1.0";
namespace "urn:law:examples:un-charter:article-51-silence";

// UNC-09: a non-State actor; the letter does not name the subject.

case NonStateSilent {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const victim: un.charter::State = entity_ref("urn:law:examples:un-charter:a51:victim");
    const group: un.charter::NonStateActor = entity_ref("urn:law:examples:un-charter:a51:group");
    const harbor: un.charter::State = entity_ref("urn:law:examples:un-charter:a51:harboring");

    assert "member": un.charter::member_state(victim) { origin case_input; }
    assert "group": un.charter::armed_attack_by_non_state_actor(group, victim) { origin case_input; }
    assert "harbor": un.charter::harbors_or_fails_to_prevent(harbor, group) { origin case_input; }
}
