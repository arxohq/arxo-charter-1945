language "law.core" version "0.2";
package examples.un.charter.army_and_authorization version "0.1.0";
namespace "urn:law:examples:un-charter:army-and-authorization";

// UNC-77B: the five have consulted.

case ConsultDischarged {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const sit: un.charter::Situation = entity_ref("urn:law:examples:un-charter:army:art106");
    const roc: un.charter::State = entity_ref("urn:un:corpus:clir:charter#RepublicOfChina");
    const france: un.charter::State = entity_ref("urn:un:corpus:clir:charter#FranceState");
    const soviet: un.charter::State = entity_ref("urn:un:corpus:clir:charter#SovietUnion");
    const uk: un.charter::State = entity_ref("urn:un:corpus:clir:charter#UnitedKingdomState");
    const us: un.charter::State = entity_ref("urn:un:corpus:clir:charter#UnitedStatesState");

    assert "needed": un.charter::joint_action_on_behalf_of_organization_necessary(sit) { origin case_input; }
    assert "roc": un.charter::consulted_for_joint_action(roc, sit) { origin case_input; }
    assert "fr": un.charter::consulted_for_joint_action(france, sit) { origin case_input; }
    assert "su": un.charter::consulted_for_joint_action(soviet, sit) { origin case_input; }
    assert "uk": un.charter::consulted_for_joint_action(uk, sit) { origin case_input; }
    assert "us": un.charter::consulted_for_joint_action(us, sit) { origin case_input; }
}
