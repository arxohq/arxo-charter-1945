language "law.core" version "0.2";
package examples.un.charter.army_and_authorization version "0.1.0";
namespace "urn:law:examples:un-charter:army-and-authorization";

// UNC-11: article 39 determination and authorization of force, without
// article 41. Kuwait-1991 as the caption of the story, not of the canon.

case KuwaitAuthorised {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const sit: un.charter::Situation = entity_ref("urn:law:examples:un-charter:army:third");

    assert "art39": un.charter::article_39_determination(sit) { origin adjudicated; }
    assert "auth": un.charter::security_council_authorises_force(sit) { origin case_input; }
}
