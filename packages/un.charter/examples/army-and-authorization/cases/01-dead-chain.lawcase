language "law.core" version "0.2";
package examples.un.charter.army_and_authorization version "0.1.0";
namespace "urn:law:examples:un-charter:army-and-authorization";

// UNC-26: force is on the file, the Council calls, no special agreement —
// the duty under article 43 does not arise.

case DeadChain {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const third: un.charter::State = entity_ref("urn:law:examples:un-charter:army:third");

    assert "member": un.charter::member_state(third) { origin case_input; }
    assert "force": un.charter::force_authorized(third) { origin adjudicated; }
    assert "call": un.charter::security_council_calls_for_forces(third, third) { origin case_input; }
}
