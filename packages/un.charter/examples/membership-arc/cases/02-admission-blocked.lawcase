language "law.core" version "0.2";
package examples.un.charter.membership_arc version "0.1.0";
namespace "urn:law:examples:un-charter:membership-arc";

// UNC-20: a permanent member blocks the recommendation. No admission.

case AdmissionBlocked {
    context {
        legal_time @2026-01-01;
        knowledge_time @2026-01-01T12:00:00Z;
        decision_time @2026-01-01T12:00:00Z;
        timezone "UTC";
    }

    const s: un.charter::State = entity_ref("urn:law:examples:un-charter:membership-arc:state");

    assert "accepts": un.charter::accepts_charter_obligations(s) { origin case_input; }
    assert "peace": un.charter::peace_loving(s) { origin adjudicated; }
    assert "blocked": un.charter::security_council_recommendation_blocked(s) { origin case_input; }
}
