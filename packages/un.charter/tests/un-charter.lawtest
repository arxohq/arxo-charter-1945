// E10 cross-cutting scenario (MULTISESSION-PROMPT.ru.md §11): admission →
// suspension → expulsion on ONE State, in ONE scenario, not three disjoint
// ones. UNC-20/21 (Art. 4), UNC-28/28B/28C (Art. 5) and UNC-29/29B (Art. 6)
// each already cover their own article in full on their own throwaway
// entities (`candidate`, `suspended`, `expelled`) — none of those rules take
// membership, suspension or expulsion as a PRECONDITION of the next (Art. 5
// and Art. 6 read only their own empirical facts about the State, never
// `admitted_to_membership`/`membership_rights_suspended` of one another), so
// there is no logical chain to exercise. This test demonstrates the
// NARRATIVE arc the prompt asks for directly: the same `member-state-arc`
// State entity is admitted, then has its rights suspended, then is expelled,
// across three `evaluate`/`expect` pairs sharing one `given` fact base (the
// same multi-query-per-test shape `UNC-49` already uses for Art. 53's two
// institutional conclusions).
test "UNC-86-MEMBERSHIP-ARC-ADMISSION-THEN-SUSPENSION-THEN-EXPULSION" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "UTC";
        }

        // Article 4: admission.
        assert "assert-f0": accepts_charter_obligations(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f1": peace_loving(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin adjudicated;
        }
        assert "assert-f2": security_council_recommends_admission(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f3": general_assembly_decides_admission(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }

        // Article 5: suspension, later in the same State's history.
        assert "assert-f4": preventive_or_enforcement_action_taken_against(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f5": security_council_recommends_suspension(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f6": is_important_question(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote")) {
            origin case_input;
        }
        assert "assert-f7": directed_at(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f8": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m0")) {
            origin case_input;
        }
        assert "assert-f9": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m1")) {
            origin case_input;
        }
        assert "assert-f10": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m2")) {
            origin case_input;
        }
        assert "assert-f11": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m3")) {
            origin case_input;
        }
        assert "assert-f12": casts_vote_against(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m4")) {
            origin case_input;
        }
        assert "assert-f13": casts_vote_against(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-suspension-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m5")) {
            origin case_input;
        }

        // Article 6: expulsion, still later, on the very same State.
        assert "assert-f14": persistently_violated_charter_principles(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin adjudicated;
        }
        assert "assert-f15": security_council_recommends_expulsion(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f16": is_important_question(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote")) {
            origin case_input;
        }
        assert "assert-f17": directed_at(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")) {
            origin case_input;
        }
        assert "assert-f18": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m0")) {
            origin case_input;
        }
        assert "assert-f19": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m1")) {
            origin case_input;
        }
        assert "assert-f20": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m2")) {
            origin case_input;
        }
        assert "assert-f21": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m3")) {
            origin case_input;
        }
        assert "assert-f22": casts_vote_against(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m4")) {
            origin case_input;
        }
        assert "assert-f23": casts_vote_against(entity_ref("urn:un:corpus:clir:charter:case:decision:arc-expulsion-vote"), entity_ref("urn:un:corpus:clir:charter:case:state:arc-m5")) {
            origin case_input;
        }
    }

    evaluate truth(admitted_to_membership(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);

    evaluate truth(membership_rights_suspended(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);

    evaluate truth(expelled_from_organization(entity_ref("urn:un:corpus:clir:charter:case:state:member-state-arc")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

