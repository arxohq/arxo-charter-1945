language "law.core" version "0.2";
package un.charter version "0.1.0";
namespace "urn:un:corpus:clir:charter";

// Scenarios carried over from the former Python runner of the `un_charter`
// family. Headers are the former scenario IDs (scenario manifest);
// expectations are derived from the FORMER checks, not from the engine's answers.

test "UNC-01-USE-OF-FORCE-VIOLATES-ARTICLE-2-4" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "UTC";
        }

        assert "assert-f0": member_state(entity_ref("urn:un:corpus:clir:charter:case:state:attacker")) {
            origin case_input;
        }

        assert "assert-f1": use_of_force(entity_ref("urn:un:corpus:clir:charter:case:state:attacker"), entity_ref("urn:un:corpus:clir:charter:case:state:victim")) {
            origin case_input;
        }
    }

    evaluate truth(violates_article_2_paragraph_4(entity_ref("urn:un:corpus:clir:charter:case:state:attacker"), entity_ref("urn:un:corpus:clir:charter:case:state:victim")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

