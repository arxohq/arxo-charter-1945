test "UNC-13-ARTICLE-27-LETTER-ABSTENTION-BLOCKS" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "UTC";
        }

        assert "assert-f0": is_non_procedural_matter(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention")) {
            origin case_input;
        }

        assert "assert-f1": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), FranceState) {
            origin case_input;
        }

        assert "assert-f2": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), UnitedKingdomState) {
            origin case_input;
        }

        assert "assert-f3": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), UnitedStatesState) {
            origin case_input;
        }

        assert "assert-f4": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m0")) {
            origin case_input;
        }

        assert "assert-f5": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m1")) {
            origin case_input;
        }

        assert "assert-f6": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m2")) {
            origin case_input;
        }

        assert "assert-f7": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m3")) {
            origin case_input;
        }

        assert "assert-f8": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m4")) {
            origin case_input;
        }

        assert "assert-f9": casts_vote_for(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), entity_ref("urn:un:corpus:clir:charter:case:state:m5")) {
            origin case_input;
        }

        assert "assert-f10": abstains(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention"), SovietUnion) {
            origin case_input;
        }
    }

    evaluate truth(decision_blocked_by_permanent_member(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);

    evaluate truth(decision_adopted(entity_ref("urn:un:corpus:clir:charter:case:decision:abstention")));
    expect truth_status == NEITHER;
    expect issues_within(info);
}

