language "law.core" version "0.1";
package un.charter version "0.1.0";
namespace "urn:un:corpus:clir:charter";

// Kuwait-1991: a determination under Article 39 plus authorization of force
// under Article 42 — without passing through Article 41, and without
// selecting any interpretation (neither the Article 51 axes nor the
// Article 23/27 axes come into play here).
test "urn:query:unc-lt-03-kuwait-1991-force-authorised" {
    given {
        context {
            decision_time @1991-01-01T12:00:00Z;
            knowledge_time @1991-01-01T12:00:00Z;
            legal_time @1991-01-01;
            timezone "UTC";
        }

        assert "determination": article_39_determination(entity_ref("urn:un:corpus:case:situation:kuwait")) {
            origin adjudicated;
        }
        assert "authorises-force": security_council_authorises_force(entity_ref("urn:un:corpus:case:situation:kuwait")) {
            origin case_input;
        }
    }

    evaluate truth(force_authorized(entity_ref("urn:un:corpus:case:situation:kuwait")));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
